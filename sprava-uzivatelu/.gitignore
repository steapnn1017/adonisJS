# Soubory a složky, které git ignoruje (nedostanou se do repozitáře)

# Nainstalované balíčky (vytvoří npm install) a přeložená aplikace (npm run build)
node_modules
build

# Databáze a dočasné soubory. Prázdná složka tmp/ v gitu zůstane díky .gitkeep.
tmp/*
!tmp/.gitkeep

# Tajné hodnoty (APP_KEY…). Do gitu jde jen vzor .env.example.
.env
.env.local
.env.production.local
.env.development.local

# Zkompilované CSS a JS (vytvoří npm run build)
public/assets

# Logy chyb balíčkovacích nástrojů
npm-debug.log
yarn-error.log

# Nastavení editorů
.fleet
.idea
.vscode

# Systémové soubory macOS
.DS_Store
