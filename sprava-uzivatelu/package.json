{
  "name": "sprava-uzivatelu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/tsconfig": "^2.0.0",
    "@iconify-json/lucide": "^1.2.136",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.6.2",
    "alpinejs": "^3.17.4",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "edge-iconify": "^2.0.2",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  }
}
