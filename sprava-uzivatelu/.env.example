# VZOR SOUBORU .env
# Zkopíruj jako .env (cp .env.example .env) a vygeneruj klíč: node ace generate:key
# Co která hodnota znamená, je popsané v start/env.ts.

# Časové pásmo serveru (časy se ukládají v UTC, česky se zobrazují v šablonách)
TZ=UTC
# Port a adresa, na které aplikace poběží → http://localhost:3333
PORT=3333
HOST=localhost
# development = vývoj, production = ostrý provoz
NODE_ENV=development
# Kolik toho vypisovat do terminálu (trace, debug, info, warn, error)
LOG_LEVEL=info
# Tajný klíč pro šifrování cookies. NIKDY ho nedávat do gitu.
APP_KEY=
