{{--
  POLE FORMULÁŘE UŽIVATELE – společná pro „Nový uživatel“ i „Úprava“.
  Vkládá se přes @include('partials/user_form') do:
    pages/users/create.edge  (proměnná user NEexistuje)
    pages/users/edit.edge    (proměnná user = upravovaný uživatel z controlleru)

  Podle toho, jestli user existuje, se mění výchozí hodnoty a texty.
  Samotný <form> a tlačítka jsou ve stránkách, tady jsou jen pole.
--}}
@let(isEdit = Boolean(user))

{{--
  old('email') existuje jen po NEúspěšném odeslání (validace vrátila formulář
  zpět). Podle toho poznáme, jestli brát hodnoty z odeslaného formuláře,
  nebo z databáze / výchozí.
--}}
@let(wasSubmitted = old('email') !== undefined)

{{-- Vybraná role: odeslaná → z DB → výchozí „user“ --}}
@let(currentRole = old('role') || (isEdit ? user.role : 'user'))

{{-- Zaškrtnutý „Aktivní účet“: odeslaný → z DB → nový účet je aktivní --}}
@let(isActiveChecked = wasSubmitted ? Boolean(old('isActive')) : (isEdit ? user.isActive : true))

{{-- 1) Jméno a e-mail --}}
@section({ title: 'Základní údaje', description: 'Jméno se zobrazuje v aplikaci, e-mail slouží k přihlášení.' })
  {{-- grid-2 = dvě pole vedle sebe (na mobilu pod sebou) --}}
  <div class="grid-2">
    @!field({ name: 'fullName', label: 'Celé jméno', value: isEdit ? user.fullName : '', placeholder: 'Jana Nováková' })
    @!field({ name: 'email', label: 'E-mail', type: 'email', value: isEdit ? user.email : '', placeholder: 'jana@firma.cz' })
  </div>
@end

{{-- 2) Role a blokace --}}
@section({ title: 'Oprávnění', description: 'Administrátor vidí správu uživatelů a může měnit cizí účty.' })
  <div class="field">
    <label for="role" class="field__label">Role</label>
    <select id="role" name="role" class="field__input">
      <option value="user" {{ currentRole === 'user' ? 'selected' : '' }}>Uživatel</option>
      <option value="admin" {{ currentRole === 'admin' ? 'selected' : '' }}>Administrátor</option>
    </select>
    {{-- @inputError = vestavěná zkratka AdonisJS: zobraz obsah, jen když má pole chybu ($messages = seznam chyb) --}}
    @inputError('role')
      <span class="field__error">{{ $messages.join(' ') }}</span>
    @end
  </div>

  {{--
    Přepínač „Aktivní účet“ je obyčejný checkbox, jen CSS ho kreslí jako
    vypínač. Zaškrtnutý pošle isActive=1, nezaškrtnutý NEpošle nic
    (proto má validátor u isActive .optional() a controller dává false).
  --}}
  <label class="switch">
    <input type="checkbox" name="isActive" value="1" class="switch__input" {{ isActiveChecked ? 'checked' : '' }} />
    <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
    <span class="switch__text">
      <span class="switch__label">Aktivní účet</span>
      <span class="field__hint">Vypnuto = účet zůstane, ale nepůjde se přihlásit.</span>
    </span>
  </label>
@end

{{-- 3) Heslo: u nového povinné, u úpravy nepovinné (prázdné = nezměnit) --}}
@section({
  title: isEdit ? 'Nové heslo' : 'Heslo',
  description: isEdit ? 'Nech prázdné, pokud heslo měnit nechceš.' : 'Alespoň 8 znaků. Uživatel si ho pak může změnit v nastavení.',
})
  @!field({ name: 'password', label: isEdit ? 'Nové heslo' : 'Heslo', type: 'password', autocomplete: 'new-password' })
@end
