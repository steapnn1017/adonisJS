{{--
  STRÁNKA: NASTAVENÍ → PROFIL  (adresa /settings/profile)
  Renderuje: ProfileController.edit()  (app/controllers/profile_controller.ts)
  Formulář odesílá na: PUT /settings/profile → ProfileController.update()
--}}
@let(me = auth.user)

@layouts.settings({ title: 'Profil' })
  {{--
    HTML formulář umí jen GET a POST. ?_method=PUT v adrese řekne AdonisJS,
    ať požadavek bere jako PUT (zapnuté v config/app.ts → allowMethodSpoofing).
  --}}
  <form method="POST" action="{{ urlFor('profile.update') }}?_method=PUT" class="stack">
    {{ csrfField() }}

    @section({ title: 'Profil', description: 'Jak tě uvidí ostatní a kam ti budeme psát.' })
      {{-- value = aktuální hodnota z databáze, ať ji uživatel jen upraví --}}
      @!field({ name: 'fullName', label: 'Celé jméno', value: me.fullName, autocomplete: 'name' })
      @!field({ name: 'email', label: 'E-mail', type: 'email', value: me.email, autocomplete: 'email' })
    @end

    <div class="form-actions">
      <button type="submit" class="btn btn--primary">Uložit profil</button>
    </div>
  </form>
@end
