{{--
  STRÁNKA: NASTAVENÍ → HESLO  (adresa /settings/password)
  Renderuje: PasswordController.edit()  (app/controllers/password_controller.ts)
  Formulář odesílá na: PUT /settings/password → PasswordController.update()
--}}
@layouts.settings({ title: 'Heslo' })
  {{-- ?_method=PUT: formulář posílá POST, AdonisJS ho bere jako PUT (viz config/app.ts) --}}
  <form method="POST" action="{{ urlFor('password.update') }}?_method=PUT" class="stack">
    {{ csrfField() }}

    @section({ title: 'Změna hesla', description: 'Pro jistotu potřebujeme i tvoje současné heslo.' })
      @!field({ name: 'currentPassword', label: 'Současné heslo', type: 'password', autocomplete: 'current-password' })
      @!field({ name: 'password', label: 'Nové heslo', type: 'password', autocomplete: 'new-password', hint: 'Alespoň 8 znaků.' })
      @!field({ name: 'passwordConfirmation', label: 'Nové heslo znovu', type: 'password', autocomplete: 'new-password' })
    @end

    <div class="form-actions">
      <button type="submit" class="btn btn--primary">Změnit heslo</button>
    </div>
  </form>
@end
