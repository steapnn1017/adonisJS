@layouts.settings({ title: 'Heslo' })
  @form({ route: 'password.update', class: 'stack' })
    @section({ title: 'Změna hesla', description: 'Pro jistotu potřebujeme i tvoje současné heslo.' })
      @field.root({ name: 'currentPassword' })
        @!field.label({ text: 'Současné heslo' })
        @!input.control({ type: 'password', autocomplete: 'current-password' })
        @!field.error()
      @end
      @field.root({ name: 'password' })
        @!field.label({ text: 'Nové heslo' })
        @!input.control({ type: 'password', autocomplete: 'new-password' })
        <span class="field__hint">Alespoň 8 znaků.</span>
        @!field.error()
      @end
      @field.root({ name: 'passwordConfirmation' })
        @!field.label({ text: 'Nové heslo znovu' })
        @!input.control({ type: 'password', autocomplete: 'new-password' })
        @!field.error()
      @end
    @end
    <div class="form-actions">
      <button type="submit" class="btn btn--primary">Změnit heslo</button>
    </div>
  @end
@end
