{{--
  RÁM STRÁNKY: nadpis, popis pod ním a volitelná tlačítka vpravo.

  Použití:
    @page({ title: 'Uživatelé', description: 'Celkem 14 účtů.' })
      @slot('actions')
        ... tlačítka vpravo od nadpisu (nepovinné) ...
      @end

      ... obsah stránky ...
    @end

  Parametry:
    title       – velký nadpis (h1)
    description – šedý text pod nadpisem (nepovinné)
    narrow      – true = užší stránka (pro formuláře), nepovinné

  Slot = pojmenované místo pro obsah. „main“ je všechno uvnitř,
  „actions“ je to, co je uvnitř @slot('actions') ... @end.
--}}
@let(title = $props.get('title'))
@let(description = $props.get('description'))

<div class="page {{ $props.get('narrow') ? 'page--narrow' : '' }}">
  <header class="page__header">
    <div>
      <h1 class="page__title">{{ title }}</h1>
      @if(description)
        <p class="page__description">{{ description }}</p>
      @end
    </div>

    {{-- Tlačítka vpravo jen tehdy, když stránka nějaká poslala --}}
    @if($slots.actions)
      <div class="page__actions">{{{ await $slots.actions() }}}</div>
    @end
  </header>

  {{-- Hlavní obsah stránky --}}
  {{{ await $slots.main() }}}
</div>
