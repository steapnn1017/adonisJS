{{--
  SEKCE FORMULÁŘE: nadpis, popis a pod nimi pole.
  Víc sekcí pod sebou se samo oddělí čárou (viz CSS .section + .section).

  Použití:
    @section({ title: 'Heslo', description: 'Alespoň 8 znaků.' })
      ... pole formuláře ...
    @end

  Parametry:
    title       – nadpis sekce
    description – šedý popis pod nadpisem (nepovinné)
--}}
<section class="section">
  <header class="section__header">
    <h2 class="section__title">{{ $props.get('title') }}</h2>
    @if($props.get('description'))
      <p class="section__description">{{ $props.get('description') }}</p>
    @end
  </header>

  {{-- Obsah sekce (pole formuláře) --}}
  <div class="section__body">{{{ await $slots.main() }}}</div>
</section>
