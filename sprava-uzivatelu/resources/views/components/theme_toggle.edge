{{-- Přepínač světlý/tmavý motiv. Logika je v resources/js/app.js (Alpine komponenta themeToggle). --}}
<button
  type="button"
  class="iconbtn"
  data-initial-theme="{{ currentTheme(request) }}"
  x-data="themeToggle"
  x-bind:aria-label="theme === 'dark' ? 'Přepnout na světlý motiv' : 'Přepnout na tmavý motiv'"
  x-bind:title="theme === 'dark' ? 'Přepnout na světlý motiv' : 'Přepnout na tmavý motiv'"
  x-on:click="toggle"
>
  @svg('lucide:sun', {
    width: 16,
    height: 16,
    class: 'themetoggle__icon themetoggle__icon--sun',
  })
  @svg('lucide:moon', {
    width: 16,
    height: 16,
    class: 'themetoggle__icon themetoggle__icon--moon',
  })
</button>
