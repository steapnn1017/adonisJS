{{--
  PŘEPÍNAČ SVĚTLÝ / TMAVÝ MOTIV
  Použití: @!themeToggle()

  Klik spustí funkci toggle z Alpine komponenty „themeToggle“
  v resources/js/app.js (x-data = která komponenta, x-on:click = co při kliku).

  V tlačítku jsou obě ikony (slunce i měsíc) přes sebe. Kterou je vidět,
  řeší jen CSS podle <html data-theme="..."> (hledej .themetoggle v app.css).
--}}
<button
  type="button"
  class="iconbtn"
  x-data="themeToggle"
  x-on:click="toggle"
  aria-label="Přepnout světlý / tmavý motiv"
  title="Přepnout motiv"
>
  @svg('lucide:sun', { width: 16, height: 16, class: 'themetoggle__icon themetoggle__icon--sun' })
  @svg('lucide:moon', { width: 16, height: 16, class: 'themetoggle__icon themetoggle__icon--moon' })
</button>
