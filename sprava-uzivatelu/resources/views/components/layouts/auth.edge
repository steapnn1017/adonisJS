{{--
  Layout pro nepřihlášené (login, registrace): formulář vlevo, popis projektu vpravo.
--}}
<!DOCTYPE html>
<html lang="cs" data-theme="{{ currentTheme(request) }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ $props.get('title') ? `${$props.get('title')} | Správa uživatelů` : 'Správa uživatelů' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        @!logo()
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
      </div>

      <aside class="auth__aside">
        <div class="auth__aside-top">
          @!themeToggle()
        </div>

        <p class="auth__quote">Účty, role a přístupy na jednom místě.</p>

        <ul class="auth__facts">
          <li>
            @svg('lucide:shield-check', { width: 16, height: 16 })
            Admin zakládá, upravuje a blokuje účty
          </li>
          <li>
            @svg('lucide:search', { width: 16, height: 16 })
            Hledání a filtry podle role a stavu
          </li>
          <li>
            @svg('lucide:lock', { width: 16, height: 16 })
            Zablokovaný účet se nepřihlásí
          </li>
        </ul>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>
