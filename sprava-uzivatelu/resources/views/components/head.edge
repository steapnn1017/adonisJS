{{--
  HLAVIČKA HTML (<head>) – společná pro layouts/app.edge a pages/login.edge.

  Použití:  @!head({ title: 'Přehled' })
  (vykřičník = komponenta nemá žádný vnitřní obsah, jen parametry)

  Parametry:
    title – název stránky v záložce prohlížeče (nepovinný)
--}}
@let(title = $props.get('title'))
<head>
  <meta charset="utf-8" />
  {{-- Na mobilu zobrazit stránku v šířce displeje, ne zmenšenou --}}
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {{-- Záložka: „Přehled | Správa uživatelů“, bez názvu jen „Správa uživatelů“ --}}
  <title>{{ title ? `${title} | Správa uživatelů` : 'Správa uživatelů' }}</title>

  {{--
    @vite vloží odkazy na CSS a JS. Při vývoji je servíruje Vite živě,
    po npm run build vloží hotové soubory z public/assets/.
  --}}
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
